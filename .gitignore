# Auth / secrets (le dossier est conservé via .gitkeep + l'exemple, jamais le contenu réel)
.auth/*
!.auth/.gitkeep
!.auth/cookies_export.example.json
credentials.json
config.local.yaml
.env
.env.local

# Cache et données téléchargées
.cache/
*.sqlite
*.db

# Données utilisateur (HTML lourds, rapports nominatifs).
# Les .gitkeep dans chaque sous-dossier data/ sont trackés pour conserver la structure.
# data/vendeurs_liste/vendeurs.yaml est intentionnellement tracké (pas ignoré).
data/wantlists/**/*.html
!data/wantlists/wantlists.html
data/sellers/**/*.html
data/panier/**/*.html
data/discovery/**/*.html
# Snapshots horodatés de data/sellers, pris avant un re-fetch pour pouvoir
# diffuser deux scrapes (voir investigation du 2026-08-13).
data/_snapshots/
reports/*.md
reports/*.csv

# Références (repos cloned pour inspiration)
references/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Editor
.idea/
.vscode/
*.swp
